# 复制为 .env 并按需修改
# 服务监听
HOST=0.0.0.0
PORT=8080

# 数据库：默认 SQLite 文件位于 backend/data/app.db
DATABASE_URL=sqlite:///./data/app.db

# JWT 密钥（生产环境务必更换为强随机值）
SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 短信验证码（mock，不接第三方短信，固定为 123456 并输出到后端日志）
MOCK_SMS_CODE=123456

# LLM 提供方：本次仅实现 mock（规则式占位），后续可扩展
LLM_PROVIDER=mock
