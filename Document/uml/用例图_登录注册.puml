@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F1F8E9
  BorderColor #689F38
  ArrowColor #333333
}
skinparam rectangle {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
actor "学习者" as Learner
actor "监护人" as Guardian
actor "管理员" as Admin
rectangle "英语口语训练系统" {
  usecase "UC-01 注册登录" as UC1
  usecase "手机号 / 第三方账号注册" as A1
  usecase "账号登录与 Token 鉴权" as A2
  usecase "找回 / 修改密码" as A3
  usecase "少儿账号监护人授权绑定" as A4
  usecase "账号信息与隐私设置" as A5
}
Learner --> UC1
Guardian --> A4
Admin --> UC1
UC1 ..> A1 : <<include>>
UC1 ..> A2 : <<include>>
UC1 ..> A3 : <<extend>>
UC1 ..> A4 : <<extend>>
UC1 ..> A5 : <<extend>>
@enduml
